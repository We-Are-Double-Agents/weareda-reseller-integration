# =============================================================================
# WeAreDA Reseller Reference Implementation - environment configuration
# =============================================================================
# Copy this file to `.env` and adjust. Never commit a real `.env`.
#
# There are THREE separate authentication contexts in this integration.
# Mixing them up is the single most common integration mistake, so every
# variable below is labelled with the direction it belongs to.
# =============================================================================

# -----------------------------------------------------------------------------
# Local sandbox server
# -----------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# Path of the SQLite file used for orders / cancellations / event history.
DATABASE_PATH=var/sandbox.db

# Debug/inspection endpoints (GET /debug/orders, /debug/products, /debug/events).
# JSON only, no HTML UI. Disable in anything resembling production.
ENABLE_DEBUG_ENDPOINTS=true

# -----------------------------------------------------------------------------
# Integration shape   (contract 1.1 and 6.1)
# -----------------------------------------------------------------------------
# These two are registered with WeAreDA at connect time
# (`npm run cli -- integration:connect`). They are mirrored here so the sandbox
# behaves the way the registration says it will.

# Which of the four calls WeAreDA makes to this server. Two independent axes:
# whether it READS from us, and whether it DELIVERS ORDERS to us.
#
#   query_and_send    reads: yes   orders: yes   catalog: pull   (DEFAULT)
#   receive_and_send  reads: NO    orders: yes   catalog: push
#   query_only        reads: yes   orders: NO    catalog: pull
#   receive_only      reads: NO    orders: NO    catalog: push
#
# The sandbox registers ONLY the routes its mode receives, so in a receive_*
# mode `GET /` and `GET /products` genuinely answer 404. Publishing webhooks
# works in every mode.
INTEGRATION_MODE=query_and_send

# May an inbound order.status move the CUSTOMER-FACING order status, and not
# just integration_status? Off by default. Requires a mode that delivers orders
# (query_and_send or receive_and_send) - combining it with query_only or
# receive_only is a 400 at connect time.
ORDER_STATUS_WRITE=false

# -----------------------------------------------------------------------------
# 1. WeAreDA -> Reseller   (inbound calls TO this server)
# -----------------------------------------------------------------------------
# Credential WeAreDA uses when calling this example reseller.
# Sent by default as:  X-API-Key: <RESELLER_API_KEY>
RESELLER_API_KEY=demo_secret

# Which inbound auth mechanism this server enforces. The contract allows
# several; this reference defaults to `api_key`.
#   api_key  ->  X-API-Key: <RESELLER_API_KEY>
#   bearer   ->  Authorization: Bearer <RESELLER_API_KEY>
#   basic    ->  Authorization: Basic base64(RESELLER_BASIC_USER:RESELLER_BASIC_PASSWORD)
#   custom   ->  <RESELLER_AUTH_HEADER>: <RESELLER_API_KEY>
#   none     ->  no authentication (local experiments only)
RESELLER_AUTH_MODE=api_key

# Only used when RESELLER_AUTH_MODE=custom
RESELLER_AUTH_HEADER=X-API-Key

# Only used when RESELLER_AUTH_MODE=basic
RESELLER_BASIC_USER=weareda
RESELLER_BASIC_PASSWORD=demo_secret

# -----------------------------------------------------------------------------
# 2. Reseller -> WeAreDA webhook   (outbound events FROM this server)
# -----------------------------------------------------------------------------
# Returned by WeAreDA after the integration is connected.
WEAREDA_WEBHOOK_URL=

# Shared secret configured in WeAreDA. Used to compute
# X-WeAreDA-Signature: sha256=<hmac-sha256 hex of the exact request body>
WEAREDA_WEBHOOK_SECRET=

# Outbound delivery tuning (retries reuse the SAME event id and body so that
# WeAreDA can deduplicate a retried delivery).
WEAREDA_WEBHOOK_TIMEOUT_MS=15000
WEAREDA_WEBHOOK_MAX_ATTEMPTS=3

# -----------------------------------------------------------------------------
# 3. Reseller -> WeAreDA management / read API   (optional)
# -----------------------------------------------------------------------------
# A DIFFERENT mechanism from the webhook HMAC above: a plain key header.
#   X-Reseller-Key: <WEAREDA_RESELLER_KEY>
#
# This plane also carries the integration configuration (contract 2):
#   npm run cli -- integration:connect --mode receive_and_send
#   npm run cli -- integration:status
#   npm run cli -- integration:test
#
# `npm run mock:weareda` serves all three locally on http://localhost:4000.
WEAREDA_API_BASE_URL=
WEAREDA_RESELLER_KEY=
WEAREDA_TENANT_ID=

# -----------------------------------------------------------------------------
# Public base URL of this sandbox (optional)
# -----------------------------------------------------------------------------
# Set this to your tunnel URL so that invoice `document_url` values point at a
# host WeAreDA can actually reach over HTTPS. When empty, the sandbox falls
# back to http://localhost:<PORT>, which WeAreDA cannot fetch.
PUBLIC_BASE_URL=
